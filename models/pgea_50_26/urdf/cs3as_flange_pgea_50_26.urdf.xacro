<?xml version="1.0"?>
<!-- CS3AS flange -> PGEA-50-26. Copy this joint into a full-arm URDF after
     including pgea_50_26.urdf (same <robot> document). Parent link name is
     typically the J6 / flange link of the CS3AS description. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="cs3as_pgea_50_26_attach">
  <xacro:macro name="cs3as_pgea_50_26_joint" params="parent:=Link6 prefix:=''">
    <joint name="${prefix}flange_to_pgea" type="fixed">
      <parent link="${parent}"/>
      <child link="pgea_base_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>
